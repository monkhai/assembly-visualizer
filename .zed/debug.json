[
    {
        "label": "Build & Debug interpreter",
        "adapter": "CodeLLDB",
        "request": "launch",
        "terminal": "console",
        "build": {
            "command": "cargo",
            "args": ["build", "--manifest-path", "interpreter/Cargo.toml"]
        },
        "program": "$ZED_WORKTREE_ROOT/interpreter/target/debug/assembly-interpreter",
        "sourceLanguages": ["rust"]
    },
    {
        "label": "Debug all tests",
        "adapter": "CodeLLDB",
        "terminal": "console",
        "build": {
            "command": "cargo",
            "args": ["test", "--lib", "--no-run"],
            "cwd": "$ZED_WORKTREE_ROOT/interpreter"
        },
        "sourceLanguages": ["rust"]
    }
]
